<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette -->
    <Color x:Key="AccentColor">#FF3B82F6</Color>
    <SolidColorBrush x:Key="App.Background" Color="#FF131317" />
    <SolidColorBrush x:Key="App.Panel" Color="#FF1B1B20" />
    <SolidColorBrush x:Key="App.PanelRaised" Color="#FF232329" />
    <SolidColorBrush x:Key="App.Border" Color="#FF2C2C34" />
    <SolidColorBrush x:Key="App.Text" Color="#FFECECF1" />
    <SolidColorBrush x:Key="App.TextDim" Color="#FF9C9CA8" />
    <SolidColorBrush x:Key="App.TextFaint" Color="#FF6E6E7A" />
    <SolidColorBrush x:Key="App.Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#FF5B9BFF" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="#333B82F6" />
    <SolidColorBrush x:Key="App.Warning" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="App.WarningSoft" Color="#33F59E0B" />

    <SolidColorBrush x:Key="Monitor.Fill" Color="#FF1F1F26" />
    <SolidColorBrush x:Key="Monitor.Border" Color="#FF3A3A46" />
    <SolidColorBrush x:Key="Monitor.Taskbar" Color="#FF0D0D11" />
    <SolidColorBrush x:Key="Zone.Fill" Color="#FF282830" />
    <SolidColorBrush x:Key="Zone.Border" Color="#FF40404C" />
    <SolidColorBrush x:Key="Zone.DragOver" Color="#663B82F6" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource App.TextDim}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource App.TextFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Primary action. Own template so hover/pressed keep the accent colour. -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource App.Accent}" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource App.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small flat button used inside zones. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource App.TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource App.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Draggable grip on the boundaries between columns / rows. -->
    <Style x:Key="GripThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="#FFD4D6DD" CornerRadius="5" BorderBrush="#AA000000" BorderThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource App.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource App.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vector logo (same design as Assets/app.ico). -->
    <DrawingImage x:Key="AppLogo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M5.3,0 H18.7 A5.3,5.3 0 0 1 24,5.3 V18.7 A5.3,5.3 0 0 1 18.7,24 H5.3 A5.3,5.3 0 0 1 0,18.7 V5.3 A5.3,5.3 0 0 1 5.3,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF2563EB" Offset="0" />
                            <GradientStop Color="#FF7C3AED" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="4.1,4.1,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#D8FFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="9.7,4.1,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                            <RectangleGeometry Rect="15.3,4.1,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                            <RectangleGeometry Rect="4.1,12.5,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                            <RectangleGeometry Rect="9.7,12.5,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                            <RectangleGeometry Rect="15.3,12.5,4.6,7.4" RadiusX="0.8" RadiusY="0.8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
