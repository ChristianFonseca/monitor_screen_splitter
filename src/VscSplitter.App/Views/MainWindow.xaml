<Window x:Class="VscSplitter.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VscSplitter.App.ViewModels"
        xmlns:c="clr-namespace:VscSplitter.App.Controls"
        xmlns:conv="clr-namespace:VscSplitter.App.Converters"
        Title="VSC Splitter"
        Width="1560" Height="960" MinWidth="1100" MinHeight="680"
        Background="{StaticResource App.Background}"
        Foreground="{StaticResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
        <conv:EmptyToVisibilityConverter x:Key="EmptyToVis" />

        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="OptionCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <!-- Large zone inside the selected-monitor editor. -->
        <DataTemplate x:Key="EditorZoneTemplate" DataType="{x:Type vm:ZoneViewModel}">
            <Border x:Name="Z" Margin="3" CornerRadius="7" BorderThickness="1.5"
                    Background="{StaticResource Zone.Fill}" BorderBrush="{StaticResource Zone.Border}"
                    AllowDrop="True" Cursor="Hand" ToolTip="{Binding Tooltip}"
                    DragEnter="Zone_DragEnter" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave" Drop="Zone_Drop"
                    PreviewMouseLeftButtonDown="Zone_PreviewMouseLeftButtonDown" MouseMove="Zone_MouseMove"
                    MouseLeftButtonUp="Zone_MouseLeftButtonUp">
                <Grid ClipToBounds="True">
                    <TextBlock Text="{Binding DisplayNumber}" FontSize="54" FontWeight="Bold" Opacity="0.09"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="Arrastra una ventana aquí" Style="{StaticResource Hint}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" IsHitTestVisible="False"
                               Visibility="{Binding HasWindow, Converter={StaticResource InvBoolToVis}}" />
                    <StackPanel Margin="11,9,30,9" VerticalAlignment="Top" IsHitTestVisible="False"
                                Visibility="{Binding HasWindow, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Ellipse Width="9" Height="9" Fill="{Binding Window.ColorBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Window.Key}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Window.Subtitle}" FontSize="11" Margin="16,3,0,0"
                                   Foreground="{StaticResource App.TextDim}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding SizeLabel}" FontSize="10" Foreground="{StaticResource App.TextFaint}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,6" IsHitTestVisible="False" />
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            ToolTip="Quitar la ventana de esta zona" AutomationProperties.Name="Quitar ventana"
                            Command="{Binding DataContext.UnassignZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding HasWindow, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWindow}" Value="True">
                    <Setter TargetName="Z" Property="Background" Value="{Binding Window.FillBrush}" />
                    <Setter TargetName="Z" Property="BorderBrush" Value="{Binding Window.ColorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Window.IsMissing}" Value="True">
                    <Setter TargetName="Z" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Z" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                    <Setter TargetName="Z" Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter TargetName="Z" Property="Background" Value="{StaticResource Zone.DragOver}" />
                    <Setter TargetName="Z" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                    <Setter TargetName="Z" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Small zone in the desktop overview. -->
        <DataTemplate x:Key="OverviewZoneTemplate" DataType="{x:Type vm:ZoneViewModel}">
            <Border x:Name="Z" Margin="1.5" CornerRadius="3" BorderThickness="1"
                    Background="{StaticResource Zone.Fill}" BorderBrush="{StaticResource Zone.Border}"
                    AllowDrop="True" Tag="overview" ToolTip="{Binding Window.Title}"
                    DragEnter="Zone_DragEnter" DragOver="Zone_DragOver" DragLeave="Zone_DragLeave" Drop="Zone_Drop"
                    PreviewMouseLeftButtonDown="Zone_PreviewMouseLeftButtonDown" MouseMove="Zone_MouseMove"
                    MouseLeftButtonUp="Zone_MouseLeftButtonUp">
                <Grid IsHitTestVisible="False" Margin="3,1">
                    <TextBlock Text="{Binding Window.Key}" FontSize="10" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasWindow, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding DisplayNumber}" FontSize="10" Foreground="{StaticResource App.TextFaint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasWindow, Converter={StaticResource InvBoolToVis}}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasWindow}" Value="True">
                    <Setter TargetName="Z" Property="Background" Value="{Binding Window.FillBrush}" />
                    <Setter TargetName="Z" Property="BorderBrush" Value="{Binding Window.ColorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Window.IsMissing}" Value="True">
                    <Setter TargetName="Z" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter TargetName="Z" Property="Background" Value="{StaticResource Zone.DragOver}" />
                    <Setter TargetName="Z" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                    <Setter TargetName="Z" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ProportionalItem" TargetType="ContentPresenter">
            <Setter Property="c:ProportionalPanel.Rect" Value="{Binding RelRect}" />
        </Style>

        <ItemsPanelTemplate x:Key="ProportionalItemsPanel">
            <c:ProportionalPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding MergeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Toolbar ============ -->
        <Border Grid.Row="0" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource AppLogo}" Width="24" Height="24" Margin="0,0,10,0" />
                    <TextBlock Text="VSC Splitter" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,26,0" />
                    <TextBlock Text="Perfil" Foreground="{StaticResource App.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="210" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding NewProfileCommand}" ToolTip="Nuevo perfil" AutomationProperties.Name="Nuevo perfil">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DuplicateProfileCommand}" ToolTip="Duplicar perfil" AutomationProperties.Name="Duplicar perfil">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding RenameProfileCommand}" ToolTip="Renombrar perfil" AutomationProperties.Name="Renombrar perfil">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding DeleteProfileCommand}" ToolTip="Eliminar perfil" AutomationProperties.Name="Eliminar perfil">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Detectar ventanas"
                            ToolTip="Vuelve a buscar ventanas de VS Code y monitores (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Detectar ventanas" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding CaptureCommand}" AutomationProperties.Name="Capturar posiciones"
                            ToolTip="Asigna cada ventana a la zona que ocupa ahora mismo en pantalla">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Margin="0,0,8,0" />
                            <TextBlock Text="Capturar posiciones" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenMissingCommand}" AutomationProperties.Name="Abrir faltantes"
                            ToolTip="Abre en VS Code las carpetas del perfil que no están abiertas (tras un reinicio)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
                            <TextBlock Text="Abrir faltantes" />
                        </StackPanel>
                    </Button>
                    <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowZoneOverlay}" AutomationProperties.Name="Ver zonas"
                                  ToolTip="Muestra las zonas directamente sobre los monitores">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Margin="0,0,8,0" />
                            <TextBlock Text="Ver zonas" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding IdentifyCommand}" AutomationProperties.Name="Identificar"
                            ToolTip="Muestra el número de cada monitor en la pantalla correspondiente">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,8,0" />
                            <TextBlock Text="Identificar" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" Margin="12,0,0,0" AutomationProperties.Name="Aplicar distribución"
                            ToolTip="Mueve y redimensiona todas las ventanas a sus zonas (Ctrl+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
                            <TextBlock Text="Aplicar distribución" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Window list -->
            <Border Grid.Column="0" Background="{StaticResource App.Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <TextBlock Text="VENTANAS DE VS CODE" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding WindowsSummary}" Foreground="{StaticResource App.TextDim}" Margin="0,0,0,10" />
                        <Grid>
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Buscar por carpeta o título…" Foreground="{StaticResource App.TextFaint}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVis}}" />
                        </Grid>
                        <CheckBox Content="Solo sin asignar" IsChecked="{Binding OnlyUnassigned}" Margin="0,8,0,0" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="14,8,14,12"
                               Text="Arrastra una ventana a una zona. Doble clic: traerla al frente. Suéltala aquí para quitarla de su zona." />
                    <ListBox x:Name="WindowList" ItemsSource="{Binding WindowsView}" AllowDrop="True"
                             Background="Transparent" BorderThickness="0" Margin="6,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="WindowList_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="WindowList_PreviewMouseMove"
                             MouseDoubleClick="WindowList_MouseDoubleClick"
                             DragOver="WindowList_DragOver" Drop="WindowList_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WindowItemViewModel}">
                                <Grid Background="Transparent" ToolTip="{Binding Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" CornerRadius="2" Background="{Binding ColorBrush}" Margin="0,1,10,1" />
                                    <StackPanel x:Name="Texts" Grid.Column="1">
                                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource App.TextDim}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border x:Name="Badge" Grid.Column="2" CornerRadius="4" Padding="7,2" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Background="#22FFFFFF">
                                        <TextBlock Text="{Binding AssignmentLabel}" FontSize="11" />
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAssigned}" Value="False">
                                        <Setter TargetName="Badge" Property="Background" Value="{StaticResource App.WarningSoft}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                        <Setter TargetName="Texts" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource App.Border}" />

            <!-- Monitors -->
            <Grid Grid.Column="2" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="110" MaxHeight="250" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="MONITORES" Style="{StaticResource SectionHeader}" Margin="0" />
                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right" TextWrapping="NoWrap"
                               Text="Disposición real de tus pantallas · clic para editar un monitor · puedes soltar ventanas aquí también" />
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource App.Panel}" CornerRadius="8" Padding="12"
                        BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:ProportionalPanel AspectRatio="{Binding DataContext.DesktopAspect, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="c:ProportionalPanel.Rect" Value="{Binding OverviewRect}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                                <Border x:Name="Card" Margin="3" CornerRadius="5" BorderThickness="2" Cursor="Hand"
                                        BorderBrush="{StaticResource Monitor.Border}" Background="{StaticResource Monitor.Taskbar}"
                                        ToolTip="{Binding Details}" MouseLeftButtonDown="OverviewMonitor_MouseLeftButtonDown">
                                    <Grid>
                                        <c:ProportionalPanel>
                                            <Border c:ProportionalPanel.Rect="{Binding ZoneAreaRect}" Background="{StaticResource Monitor.Fill}" />
                                        </c:ProportionalPanel>
                                        <ItemsControl ItemsSource="{Binding Zones}" ItemTemplate="{StaticResource OverviewZoneTemplate}"
                                                      ItemsPanel="{StaticResource ProportionalItemsPanel}"
                                                      ItemContainerStyle="{StaticResource ProportionalItem}" />
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4" Padding="5,1"
                                                CornerRadius="3" Background="#CC0D0D11" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Caption}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource App.Accent}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Grid Grid.Row="2" Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedMonitor.Title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedMonitor.Resolution}" FontSize="14" Margin="12,0,0,1" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="2" Text="{Binding SelectedMonitor.Details}" Foreground="{StaticResource App.TextDim}" Margin="12,0,16,1"
                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMonitor.Details}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Hint}" TextWrapping="NoWrap" VerticalAlignment="Bottom"
                               Text="Clic: seleccionar · Ctrl+clic: varias · arrastra los tiradores para cambiar tamaños" />
                </Grid>

                <!-- Selected monitor editor -->
                <Border Grid.Row="3" Background="{StaticResource App.Panel}" CornerRadius="8" Padding="22"
                        BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                    <c:ProportionalPanel AspectRatio="{Binding SelectedMonitor.AspectRatio}">
                        <Grid x:Name="DetailSurface" DataContext="{Binding SelectedMonitor}" Background="Transparent"
                              MouseLeftButtonDown="DetailSurface_MouseLeftButtonDown">
                            <Border CornerRadius="9" Background="{StaticResource Monitor.Taskbar}"
                                    BorderBrush="{StaticResource Monitor.Border}" BorderThickness="2" />
                            <c:ProportionalPanel>
                                <Border c:ProportionalPanel.Rect="{Binding ZoneAreaRect}" Background="{StaticResource Monitor.Fill}" CornerRadius="7" />
                            </c:ProportionalPanel>

                            <ItemsControl ItemsSource="{Binding Zones}" ItemTemplate="{StaticResource EditorZoneTemplate}"
                                          ItemsPanel="{StaticResource ProportionalItemsPanel}"
                                          ItemContainerStyle="{StaticResource ProportionalItem}" />

                            <!-- Column boundaries: grip on the top edge. -->
                            <ItemsControl ItemsSource="{Binding ColumnHandles}"
                                          ItemsPanel="{StaticResource ProportionalItemsPanel}"
                                          ItemContainerStyle="{StaticResource ProportionalItem}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BoundaryHandleViewModel}">
                                        <Grid Width="16">
                                            <Border Width="2" Background="{StaticResource App.Accent}" HorizontalAlignment="Center" IsHitTestVisible="False"
                                                    Visibility="{Binding IsDragging, Converter={StaticResource BoolToVis}}" />
                                            <Thumb Style="{StaticResource GripThumb}" Width="12" Height="38" VerticalAlignment="Top" Margin="0,-14,0,0"
                                                   Cursor="SizeWE" ToolTip="{Binding Tooltip}"
                                                   DragStarted="Handle_DragStarted" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Row boundaries: grip on the left edge. -->
                            <ItemsControl ItemsSource="{Binding RowHandles}"
                                          ItemsPanel="{StaticResource ProportionalItemsPanel}"
                                          ItemContainerStyle="{StaticResource ProportionalItem}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BoundaryHandleViewModel}">
                                        <Grid Height="16">
                                            <Border Height="2" Background="{StaticResource App.Accent}" VerticalAlignment="Center" IsHitTestVisible="False"
                                                    Visibility="{Binding IsDragging, Converter={StaticResource BoolToVis}}" />
                                            <Thumb Style="{StaticResource GripThumb}" Width="38" Height="12" HorizontalAlignment="Left" Margin="-14,0,0,0"
                                                   Cursor="SizeNS" ToolTip="{Binding Tooltip}"
                                                   DragStarted="Handle_DragStarted" DragDelta="Handle_DragDelta" DragCompleted="Handle_DragCompleted" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </c:ProportionalPanel>
                </Border>
            </Grid>

            <!-- Layout tools -->
            <Border Grid.Column="3" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Border}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14,16,16">
                        <TextBlock Text="DISTRIBUCIÓN" Style="{StaticResource SectionHeader}" />
                        <TextBlock Text="{Binding SelectedMonitor.GridLabel}" Foreground="{StaticResource App.TextDim}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PresetViewModel}">
                                    <Button Style="{StaticResource PresetButton}" ToolTip="{Binding Tooltip}"
                                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Tooltip}">
                                        <ItemsControl ItemsSource="{Binding Rects}" Height="28" IsHitTestVisible="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <c:ProportionalPanel AspectRatio="1.7778" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="c:ProportionalPanel.Rect" Value="{Binding}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="1.5" Background="#FFA3ACBB" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="PERSONALIZADA" Style="{StaticResource SectionHeader}" Margin="0,14,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Columnas" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource StepButton}" Content="&#xE738;" Command="{Binding RemoveColumnCommand}" ToolTip="Quitar columna" AutomationProperties.Name="Quitar columna" />
                            <TextBlock Grid.Column="2" Text="{Binding SelectedMonitor.Columns}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Style="{StaticResource StepButton}" Content="&#xE710;" Command="{Binding AddColumnCommand}" ToolTip="Añadir columna" AutomationProperties.Name="Añadir columna" />
                            <TextBlock Grid.Row="2" Text="Filas" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource StepButton}" Content="&#xE738;" Command="{Binding RemoveRowCommand}" ToolTip="Quitar fila" AutomationProperties.Name="Quitar fila" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedMonitor.Rows}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource StepButton}" Content="&#xE710;" Command="{Binding AddRowCommand}" ToolTip="Añadir fila" AutomationProperties.Name="Añadir fila" />
                        </Grid>
                        <UniformGrid Columns="3" Margin="0,4,0,4">
                            <Button Style="{StaticResource PanelButton}" Margin="0,0,4,0" Command="{Binding MergeCommand}" Content="Unir" HorizontalContentAlignment="Center"
                                    ToolTip="Une las zonas seleccionadas (Ctrl+clic para elegir varias) · Ctrl+M" />
                            <Button Style="{StaticResource PanelButton}" Margin="2,0,2,0" Command="{Binding SplitCommand}" Content="Separar" HorizontalContentAlignment="Center"
                                    ToolTip="Separa la zona unida seleccionada en celdas" />
                            <Button Style="{StaticResource PanelButton}" Margin="4,0,0,0" Command="{Binding EqualizeCommand}" Content="Igualar" HorizontalContentAlignment="Center"
                                    ToolTip="Todas las columnas y filas del mismo tamaño" />
                        </UniformGrid>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Selecciona zonas con clic (Ctrl+clic para varias) y únelas para crear zonas grandes. Arrastra los tiradores de los bordes para ajustar anchos y altos." />

                        <TextBlock Text="ESPACIADO" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMonitor.Gap, StringFormat={}{0} px}" Foreground="{StaticResource App.TextDim}" />
                            <TextBlock Text="Entre ventanas" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8"
                                Value="{Binding SelectedMonitor.Gap}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMonitor.Margin, StringFormat={}{0} px}" Foreground="{StaticResource App.TextDim}" />
                            <TextBlock Text="Margen con el borde" />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,8"
                                Value="{Binding SelectedMonitor.Margin}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Respetar la barra de tareas" IsChecked="{Binding SelectedMonitor.UseWorkArea}" />

                        <TextBlock Text="ACCIONES" Style="{StaticResource SectionHeader}" Margin="0,18,0,8" />
                        <Button Style="{StaticResource PanelButton}" Command="{Binding FillEmptyCommand}"
                                ToolTip="Coloca las ventanas sin asignar en las zonas vacías (empezando por este monitor)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" Margin="0,0,8,0" FontSize="12" />
                                <TextBlock Text="Rellenar zonas vacías" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PanelButton}" Command="{Binding ApplyMonitorCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" FontSize="12" />
                                <TextBlock Text="Aplicar solo este monitor" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PanelButton}" Command="{Binding ClearMonitorCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" Margin="0,0,8,0" FontSize="12" />
                                <TextBlock Text="Vaciar este monitor" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="AUTOMÁTICO" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Auto-colocar ventanas al abrirse" IsChecked="{Binding AutoPlaceEnabled}"
                                  ToolTip="Cuando una carpeta del perfil se abre (p. ej. tras reiniciar), su ventana va sola a su zona" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Aplicar en vivo al editar" IsChecked="{Binding LiveApply}"
                                  ToolTip="Mueve las ventanas en cuanto sueltas una ventana o cambias la distribución" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Aplicar al iniciar la app" IsChecked="{Binding ApplyOnStartup}" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Iniciar con Windows" IsChecked="{Binding StartWithWindows}"
                                  ToolTip="Arranca en la bandeja del sistema al iniciar sesión" />
                        <CheckBox Style="{StaticResource OptionCheck}" Content="Al cerrar, seguir en la bandeja" IsChecked="{Binding MinimizeToTray}" />
                        <TextBlock Text="Procesos a gestionar" Margin="0,10,0,4" Foreground="{StaticResource App.TextDim}" />
                        <TextBox Text="{Binding ProcessNamesText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Nombres de proceso separados por coma (p. ej. Code, Code - Insiders, Cursor)" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="2" Background="{StaticResource App.Panel}" BorderBrush="{StaticResource App.Border}" BorderThickness="0,1,0,0" Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" TextWrapping="NoWrap" Margin="16,0,0,0"
                           Text="{Binding ConfigPathDisplay, StringFormat='Autoguardado en {0}'}" ToolTip="{Binding ConfigPath}" />
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="70" Height="4" Margin="0,0,10,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
