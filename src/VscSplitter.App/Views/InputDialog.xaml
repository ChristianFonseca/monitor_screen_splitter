<Window x:Class="VscSplitter.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VSC Splitter"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource App.Panel}" Foreground="{StaticResource App.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptLabel" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="Input" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,6" Margin="0,0,8,0" />
            <Button Content="Aceptar" IsDefault="True" Style="{StaticResource AccentButton}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
